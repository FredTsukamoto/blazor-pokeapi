@page "/"
@inject HttpClient Http
@using BlazorPokeApi.Models

<PageTitle>Buscar Pokémon</PageTitle>

<h1>Buscar Pokémon</h1>

<div class="mb-2">
    <label for="nome">Nome do Pokémon:</label>
    <input id="nome" class="form-control" @bind="nomePokemon" @bind:event="oninput"
           @onkeydown="TeclaPressionada" />
</div>

<button class="btn btn-primary" @onclick="BuscarPokemon" disabled="@carregando">
    Buscar Pokémon
</button>

<hr />

@if (carregando)
{
    <p>Carregando...</p>
}
else if (!string.IsNullOrEmpty(erro))
{
    <p class="text-danger">@erro</p>
}
else if (pokemon is not null)
{
    <h3>Detalhes do Pokémon</h3>

    @if (!string.IsNullOrEmpty(pokemon.Sprites.Other.OfficialArtwork.FrontDefault))
    {
        <img src="@pokemon.Sprites.Other.OfficialArtwork.FrontDefault"
             alt="@pokemon.Name" width="200" />
    }

    <p><strong>ID:</strong> @pokemon.Id</p>
    <p><strong>Nome:</strong> @pokemon.Name</p>
    <p><strong>Altura:</strong> @((pokemon.Height / 10.0).ToString("0.0")) m</p>
    <p><strong>Peso:</strong> @((pokemon.Weight / 10.0).ToString("0.0")) kg</p>
}

@code {
    private string nomePokemon = string.Empty;
    private Pokemon? pokemon;
    private string? erro;
    private bool carregando;

    private async Task TeclaPressionada(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
            await BuscarPokemon();
    }

    private async Task BuscarPokemon()
    {
        erro = null;
        pokemon = null;

        if (string.IsNullOrWhiteSpace(nomePokemon))
        {
            erro = "Digite o nome de um Pokémon.";
            return;
        }

        carregando = true;

        try
        {
            var url = $"https://pokeapi.co/api/v2/pokemon/{nomePokemon.Trim().ToLower()}";
            pokemon = await Http.GetFromJsonAsync<Pokemon>(url);
        }
        catch (HttpRequestException)
        {
            erro = "Pokémon não encontrado ou sem conexão com a internet.";
        }
        finally
        {
            carregando = false;
        }
    }
}